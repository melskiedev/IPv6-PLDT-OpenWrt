#!/bin/sh
# /usr/bin/ipv6-discord-logger
# v3.9.6
# Optional: only needed if you want real-time Discord log forwarding.
# See the Optional: Discord Notifications section in the README for full setup instructions.
# Requires a Discord webhook configured in /etc/ipv6-watchdog.conf.
#
# Tails syslog and forwards tagged entries to a Discord webhook.
# Managed by procd via /etc/init.d/ipv6-discord-logger.

LOGTAG="discord-logger"
CONF="/etc/ipv6-watchdog.conf"
[ -f "$CONF" ] && . "$CONF"
[ -z "$DISCORD_LOG_WEBHOOK" ] && DISCORD_LOG_WEBHOOK="$DISCORD_WEBHOOK"
[ -z "$DISCORD_LOG_WEBHOOK" ] && {
    logger -t "$LOGTAG" "ERROR: No webhook configured in $CONF, exiting"
    exit 1
}

# Syslog tags to forward. Pipe-separated for grep -E.
# Override in /etc/ipv6-watchdog.conf to add tags from other scripts
# (e.g. WATCH_TAGS="ipv6-setup|ipv6-watchdog|discord-logger|tailscale-watchdog|ipv6-prefix").
WATCH_TAGS="${WATCH_TAGS:-ipv6-setup|ipv6-watchdog|discord-logger}"

color_for() {
    case "$1" in
        *"ACTION REQUIRED"*)               echo 15158332 ;;  # red
        *"ERROR"*)                         echo 15158332 ;;  # red
        *"Bootstrap failed"*)              echo 15158332 ;;  # red
        *"Prefix acquired via bootstrap"*) echo 3066993  ;;  # green
        *"recovered"*|*"Recovered"*)       echo 3066993  ;;  # green
        *"WARN"*)                          echo 16744272 ;;  # orange
        *"bootstrap"*|*"restart"*)         echo 16744272 ;;  # orange
        *)                                 echo 9807270  ;;  # gray
    esac
}

# Strip only the known syslog tag prefix from the message body.
# Reads WATCH_TAGS dynamically so adding tags to the conf file
# automatically updates both grep filtering and message extraction.
extract_msg() {
    local line="$1"
    local tag prefix
    for tag in $(echo "$WATCH_TAGS" | tr '|' ' '); do
        prefix="${tag}: "
        case "$line" in
            *"$prefix"*)
                printf '%s\n' "${line#*${prefix}}"
                return
            ;;
        esac
    done
    printf '%s\n' "$line"
}

# Return the matched syslog tag for use in the Discord footer.
extract_tag() {
    local line="$1"
    local tag prefix
    for tag in $(echo "$WATCH_TAGS" | tr '|' ' '); do
        prefix="${tag}: "
        case "$line" in
            *"$prefix"*)
                printf '%s\n' "$tag"
                return
            ;;
        esac
    done
    printf '%s\n' "unknown"
}

logger -t "$LOGTAG" "Log forwarder started, watching: $WATCH_TAGS"

HOST=$(uci get system.@system[0].hostname 2>/dev/null || echo "OpenWrt")
HOST=$(printf '%s' "$HOST" | tr -d '\n\r\t')

logread -f 2>/dev/null | grep -E "$WATCH_TAGS" | grep -v "crond" | while read -r line; do
    COLOR=$(color_for "$line")
    TIMESTAMP=$(date '+%b %d %Y %I:%M:%S %p')
    MSG=$(extract_msg "$line")
    SRC_TAG=$(extract_tag "$line")
    SRC_TAG=$(printf '%s' "$SRC_TAG" | tr -d '\n\r\t')

    # Escape backslashes and double quotes for JSON safety.
    SAFE=$(printf '%s' "$MSG" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\n\r\t')

    PAYLOAD=$(cat <<PAYLOAD
{
  "embeds": [{
    "description": "$SAFE",
    "color": $COLOR,
    "footer": { "text": "$HOST | $SRC_TAG | $TIMESTAMP" }
  }]
}
PAYLOAD
)

    curl -s --connect-timeout 3 --max-time 8 \
        -H "Content-Type: application/json" \
        -X POST \
        -d "$PAYLOAD" \
        "$DISCORD_LOG_WEBHOOK" >/dev/null 2>&1

    # Discord allows 5 requests per 2 seconds per webhook.
    # Sleep 1s between posts to stay well under the limit during log bursts.
    sleep 1
done
