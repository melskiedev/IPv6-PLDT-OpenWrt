#!/bin/sh
# /etc/hotplug.d/iface/99-ipv6-setup
# IPv6 route fix engine. Runs on wan6 ifup.
# Selects the working gateway via per-candidate internet reachability testing,
# pins its MAC, installs the default route, and removes the /128.

[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "wan6" ] || exit 0

LOGTAG="ipv6-setup"
log() { logger -t "$LOGTAG" "$1"; }

# Prevent overlapping executions. This script can run for 2+ minutes during
# gateway scan and WAN recovery. Repeated wan6 hotplug events can overlap.
# flock is preferred; mkdir is a fallback for images without flock.
LOCK="/tmp/ipv6-setup.lock"
LOCK_DIR="/tmp/ipv6-setup.lock.dir"
if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK"
    flock -n 9 || { log "Already running, skipping"; exit 0; }
else
    mkdir "$LOCK_DIR" 2>/dev/null || { log "Already running, skipping"; exit 0; }
    cleanup_lock() { rmdir "$LOCK_DIR" 2>/dev/null; }
    trap 'cleanup_lock' EXIT
    trap 'cleanup_lock; exit 130' INT
    trap 'cleanup_lock; exit 143' TERM
fi

CONF="/etc/ipv6-watchdog.conf"
[ -f "$CONF" ] && . "$CONF"

# Remove temporary WAN /128 addresses after connectivity is confirmed.
# Set to 0 on routers where WAN /128 is a legitimate persistent address (e.g. Globe IA_NA mode).
CLEANUP_WAN128="${CLEANUP_WAN128:-1}"

# ===== GET WAN DEVICE =====
WAN_DEV=$(ubus call network.interface.wan6 status 2>/dev/null \
    | jsonfilter -e '@["l3_device"]' 2>/dev/null)
[ -z "$WAN_DEV" ] && { log "ERROR: cannot determine WAN device"; exit 1; }
log "WAN device: $WAN_DEV"

# ===== WAIT FOR LINK-LOCAL =====
# Using a while loop to avoid a seq fork on ash/BusyBox.
i=0
while [ "$i" -lt 10 ]; do
    i=$((i + 1))
    lla=$(ip -6 addr show dev "$WAN_DEV" | awk '/fe80.*scope link/{print $2}')
    [ -n "$lla" ] && { log "LLA ready: $lla"; break; }
    [ "$i" -eq 10 ] && { log "ERROR: LLA never appeared on $WAN_DEV"; exit 1; }
    sleep 2
done

# ===== WAIT FOR PREFIX DELEGATION =====
log "Waiting for prefix delegation..."
PREFIX=""
i=0
while [ "$i" -lt 15 ]; do
    i=$((i + 1))
    PREFIX=$(ubus call network.interface.wan6 status 2>/dev/null \
        | jsonfilter -e '@["ipv6-prefix"][0].address' 2>/dev/null)
    [ -n "$PREFIX" ] && { log "Prefix received: $PREFIX"; break; }
    sleep 3
done
if [ -z "$PREFIX" ]; then
    log "WARNING: no PD received after 45s -- deferring prefix recovery to ipv6-watchdog"
    exit 0
fi

# ===== TRIGGER NDP DISCOVERY =====
# Ping all-routers multicast to trigger router responses and refresh NDP state
# for all routers on the link before the candidate scan.
log "Triggering NDP discovery via all-routers multicast..."
ping6 -c 3 -W 3 -I "$WAN_DEV" ff02::2 >/dev/null 2>&1
sleep 3

# Also send unicast probes to gateways already in the route table to refresh
# their neighbor entries before the scan. Uses keyword-based extraction to
# handle source-specific route formats correctly.
ip -6 route show default dev "$WAN_DEV" | while read -r route; do
    gw=$(printf '%s\n' "$route" \
        | awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}')
    [ -n "$gw" ] && ping6 -c 1 -W 1 -I "$WAN_DEV" "$gw" >/dev/null 2>&1
done
sleep 3

# ===== DISCOVER WORKING GATEWAY =====
# Combine neighbor table and existing routes for the candidate list.
# Test internet reachability per candidate -- do not accept a gateway that
# responds locally but does not forward internet traffic. This is the dominant
# PLDT failure mode: the dead gateway replies to ICMPv6 echo but silently drops
# all other traffic.
log "Scanning gateways on $WAN_DEV..."
BEST_GW=""
BEST_MAC=""

for gw in $(
    { ip -6 neigh show dev "$WAN_DEV" | awk '/router/{print $1}'
      ip -6 route show default dev "$WAN_DEV" \
          | awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1)}}'
    } | sort -u | grep -v '^$'
); do
    state=$(ip -6 neigh show dev "$WAN_DEV" | awk -v g="$gw" '$1==g{print $NF}')
    mac=$(ip -6 neigh show dev "$WAN_DEV" \
        | awk -v g="$gw" '$1==g && /lladdr/{print $3}' | head -1)
    log "Gateway $gw -- state: ${state:-unknown} mac: ${mac:-unknown}"

    # If MAC is not yet resolved, send a unicast probe to trigger NDP resolution.
    if [ -z "$mac" ]; then
        ping6 -c 2 -W 2 -I "$WAN_DEV" "$gw" >/dev/null 2>&1
        sleep 1
        mac=$(ip -6 neigh show dev "$WAN_DEV" \
            | awk -v g="$gw" '$1==g && /lladdr/{print $3}' | head -1)
    fi

    [ -z "$mac" ] && { log "Gateway $gw -- MAC not resolved, skipping"; continue; }

    # Install candidate temporarily and test internet reachability.
    # This is the same approach used by fix_gateway() in ipv6-watchdog.
    log "Gateway $gw -- testing internet reachability (mac $mac)"
    ip -6 neigh replace "$gw" lladdr "$mac" dev "$WAN_DEV" nud stale 2>/dev/null
    ip -6 route replace default via "$gw" dev "$WAN_DEV" metric 512
    sleep 2

    if ping6 -c 2 -W 3 2001:4860:4860::8888 >/dev/null 2>&1 || \
       ping6 -c 2 -W 3 2606:4700:4700::1111 >/dev/null 2>&1; then
        BEST_GW="$gw"
        BEST_MAC="$mac"
        log "Gateway $gw -- internet reachability verified, selected"
        break
    fi

    log "Gateway $gw -- responds locally but no internet reachability, rejecting"
    ip -6 route del default via "$gw" dev "$WAN_DEV" 2>/dev/null
done

# ===== NO GATEWAY FOUND -- RECOVER =====
if [ -z "$BEST_GW" ]; then
    log "ERROR: no working gateway found -- restarting WAN"
    ifdown wan6
    ifdown wan
    sleep 20
    ifup wan
    sleep 40
    ifup wan6
    exit 0
fi

# ===== REMOVE COMPETING ROUTES =====
# Remove any remaining default routes that point to other gateways.
# The winning candidate route was already installed during discovery.
# Uses keyword-based via/from extraction to handle source-specific route formats.
ip -6 route show default dev "$WAN_DEV" | while read -r route; do
    gw=$(printf '%s\n' "$route" \
        | awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}')
    src=$(printf '%s\n' "$route" \
        | awk '{for(i=1;i<=NF;i++) if($i=="from"){print $(i+1); exit}}')
    [ -z "$gw" ] && continue
    # Keep the winning generic route; remove everything else.
    [ "$gw" = "$BEST_GW" ] && [ -z "$src" ] && continue
    if [ -n "$src" ]; then
        ip -6 route del default from "$src" via "$gw" dev "$WAN_DEV" 2>/dev/null && \
            log "Removed competing source-specific route: default from $src via $gw"
    else
        ip -6 route del default via "$gw" dev "$WAN_DEV" 2>/dev/null && \
            log "Removed competing route via $gw"
    fi
done

# ===== REMOVE /128 =====
# Internet reachability was confirmed during gateway selection.
# Remove the /128 IA_NA address now that the correct route is in place.
# Skip removal if CLEANUP_WAN128 is 0 (e.g. Globe IA_NA mode).
if [ "${CLEANUP_WAN128}" = "1" ]; then
    ip -6 addr show dev "$WAN_DEV" | awk '/\/128 scope global/{print $2}' \
    | while read -r addr; do
        ip -6 addr del "$addr" dev "$WAN_DEV" 2>/dev/null && \
            log "Removed /128 $addr after confirmed connectivity"
    done
fi

log "IPv6 setup complete via $BEST_GW (mac $BEST_MAC)"

# ===== VERIFY LAN RA CONFIG =====
# Checks that odhcpd is configured correctly for IPv6 RA and DHCPv6 on LAN.
# Auto-corrects and restarts odhcpd if any setting is wrong.
# Guards against config drift after sysupgrade or manual changes.
ra_ok=1
for key in ra ra_slaac dhcpv6 ra_default; do
    val=$(uci get dhcp.lan.$key 2>/dev/null)
    case "$key" in
        ra)         expected="server" ;;
        ra_slaac)   expected="1" ;;
        dhcpv6)     expected="server" ;;
        ra_default) expected="1" ;;
    esac
    if [ "$val" != "$expected" ]; then
        log "WARNING: dhcp.lan.$key is '${val:-unset}', expected '$expected' -- fixing"
        uci set dhcp.lan.$key="$expected"
        ra_ok=0
    fi
done

if [ "$ra_ok" -eq 0 ]; then
    uci commit dhcp
    if /etc/init.d/odhcpd running 2>/dev/null; then
        /etc/init.d/odhcpd restart
    else
        /etc/init.d/odhcpd start
    fi
    log "LAN RA config corrected and odhcpd restarted"
else
    log "LAN RA config OK"
fi
