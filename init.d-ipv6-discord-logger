#!/bin/sh /etc/rc.common
# /etc/init.d/ipv6-discord-logger
# Optional: only needed if you want real-time Discord log forwarding.
# See the Optional: Discord Notifications section in the README for full setup instructions.

START=99
STOP=10
USE_PROCD=1

stop_service() {
    killall ipv6-discord-logger 2>/dev/null
    killall logread 2>/dev/null
}

start_service() {
    killall ipv6-discord-logger 2>/dev/null
    killall logread 2>/dev/null
    sleep 1

    procd_open_instance
    procd_set_param command /usr/bin/ipv6-discord-logger
    procd_set_param respawn 30 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
